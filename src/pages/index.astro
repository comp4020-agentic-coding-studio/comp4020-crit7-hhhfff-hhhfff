---
import Layout from "../layouts/Layout.astro";
import { listLibraries, listSpaces } from "../lib/db";

const libraries = listLibraries();
---

<Layout title="Find a space">
  <h1>Find a study space</h1>
  {
    libraries.map((library) => (
      <section>
        <h2>{library} Library</h2>
        <ul>
          {listSpaces(library).map((s) => (
            <li>
              {s.name} — {s.kind === "group" ? `group room, ${s.capacity} people` : "single seat"}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
