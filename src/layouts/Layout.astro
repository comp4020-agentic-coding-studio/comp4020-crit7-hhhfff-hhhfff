---
import "../styles.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Find a space" },
  { href: "/my/", label: "My bookings" },
  { href: "/readme/", label: "About" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ANU Library spaces</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <nav aria-label="site">
        <span class="brand">ANU Library spaces</span>
        {
          links.map((l) => (
            <a href={l.href} aria-current={path === l.href ? "page" : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
